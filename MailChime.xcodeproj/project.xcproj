          "kind": "group",
          "path": "MailChimeKitTests",
          "children": [
            { "path": "ConfigurationTests.swift", "target-membership": [ "MailChimeTests/compile-sources" ] },
            { "path": "push-vector.json", "target-membership": [ "MailChimeTests/resources" ] },
          ],
        }, {
          "kind": "group",
          "path": "MailChimeTests",
          "children": [
            { "path": "WorkerTests.swift", "target-membership": [ "MailChimeTests/compile-sources" ] },
          ],
        },
      ],
