{
  "organization": "RHPT",
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "LICENSE", "target-membership": [ "MailChime/resources" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/MailChime.app", "id": "00000000000000000000000F", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/libMailChimeKit.a",
          "id": "00000000000000000000003D",
          "type": "archive.ar",
          "index": false,
          "target-membership": [
            "MailChime/frameworks",
            "MailChimeNotificationService/frameworks",
          ],
        },
        { "path": "<PRODUCTS>/MailChimeTests.xctest", "id": "00000000000000000000002F", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/MailChimeNotificationService.appex", "id": "000000000000000000000050", "type": "wrapper.app-extension", "index": false, "target-membership": [ "MailChime/copy/Embed Foundation Extensions" ] },
      ],
    }, {
      "kind": "group",
      "path": "Sources",
      "children": [
        {
          "kind": "group",
          "path": "MailChimeKit",
          "children": [
            { "path": "Configuration.swift", "target-membership": [ "MailChimeKit/compile-sources" ] },
            { "path": "MessageHeaders.swift", "target-membership": [ "MailChimeKit/compile-sources" ] },
            { "path": "NotificationContent.swift", "target-membership": [ "MailChimeKit/compile-sources" ] },
            { "path": "ReadStatus.swift", "target-membership": [ "MailChimeKit/compile-sources" ] },
            { "path": "PushPayload.swift", "target-membership": [ "MailChimeKit/compile-sources" ] },
            { "path": "SharedKeychain.swift", "target-membership": [ "MailChimeKit/compile-sources" ] },
            { "path": "SharedState.swift", "target-membership": [ "MailChimeKit/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "MailChime",
          "children": [
            {
              "kind": "group",
              "path": "App",
              "children": [
                { "path": "MailChimeApp.swift", "target-membership": [ "MailChime/compile-sources" ] },
                { "path": "LicenseWindowController.swift", "target-membership": [ "MailChime/compile-sources" ] },
                { "path": "SettingsModel.swift", "target-membership": [ "MailChime/compile-sources" ] },
                { "path": "BackgroundAppDelegate.swift", "target-membership": [ "MailChime/compile-sources" ] },
                { "path": "SingleInstance.swift", "target-membership": [ "MailChime/compile-sources" ] },
                { "path": "NotificationResponseHandler.swift", "target-membership": [ "MailChime/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "path": "Auth",
              "children": [
                { "path": "CredentialStore.swift", "target-membership": [ "MailChime/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "path": "Service",
              "children": [
                { "path": "AgentController.swift", "target-membership": [ "MailChime/compile-sources" ] },
                { "path": "AgentStore.swift", "target-membership": [ "MailChime/compile-sources" ] },
                { "path": "FailureReporter.swift", "target-membership": [ "MailChime/compile-sources" ] },
                { "path": "ReadNotificationReconciler.swift", "target-membership": [ "MailChime/compile-sources" ] },
                { "path": "CatchUpWorker.swift", "target-membership": [ "MailChime/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "path": "Relay",
              "children": [
                { "path": "RelayAPI.swift", "target-membership": [ "MailChime/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "path": "Push",
              "children": [
                { "path": "PushRegistrar.swift", "target-membership": [ "MailChime/compile-sources" ] },
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "MailChimeNotificationService",
          "children": [
            { "path": "NotificationService.swift", "target-membership": [ "MailChimeNotificationService/compile-sources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Support",
      "children": [
        { "path": "Info.plist" },
        {
          "path": "Notification_A.aiff",
          "target-membership": [
            "MailChime/resources",
            "MailChimeNotificationService/resources",
          ],
        }, {
          "path": "Localizable.xcstrings",
          "target-membership": [
            "MailChime/resources",
            "MailChimeNotificationService/resources",
          ],
        },
