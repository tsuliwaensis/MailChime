  "targets": [
    {
      "name": "MailChime",
      "id": "00000000000000000000002C",
      "product": "Products/MailChime.app",
      "product-type": "application",
      "dependencies": [
        "MailChimeKit",
        "MailChimeNotificationService",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Launch Agent",
          "bundle-base-path": "root",
          "relative-path": "Contents/Library/LaunchAgents",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "root",
          "relative-path": "Contents/PlugIns",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "NewAppIcon",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Support/MailChime.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1794237349",
        "DEAD_CODE_STRIPPING": "YES",
        "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
        "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
        "DEVELOPMENT_TEAM": "F8AV3SGQFB",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "ENABLE_TESTABILITY[config=Release]": "NO",
        "EXECUTABLE_NAME": "MailChime",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Support/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "MailChime",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "2.0",
        "MailChime_APS_ENVIRONMENT[config=Debug]": "development",
        "MailChime_APS_ENVIRONMENT[config=Release]": "production",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.rhpt.mailchime",
        "PRODUCT_NAME": "MailChime",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
      },
    }, {
      "name": "MailChimeKit",
      "id": "000000000000000000000044",
      "product": "Products/libMailChimeKit.a",
      "product-type": "library.static",
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "DEAD_CODE_STRIPPING": "YES",
        "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
        "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
        "DEFINES_MODULE": "YES",
        "ENABLE_MODULE_VERIFIER": "YES",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "ENABLE_TESTABILITY[config=Release]": "NO",
        "MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS": "gnu17 gnu++14",
        "PRODUCT_MODULE_NAME": "MailChimeKit",
        "PRODUCT_NAME": "MailChimeKit",
        "SKIP_INSTALL": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
      },
    }, {
      "name": "MailChimeTests",
      "id": "000000000000000000000039",
      "product": "Products/MailChimeTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "MailChime",
      "dependencies": [
        "MailChimeKit",
        "MailChime",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "DEAD_CODE_STRIPPING": "YES",
        "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
        "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
        "DEVELOPMENT_TEAM": "F8AV3SGQFB",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "ENABLE_TESTABILITY[config=Release]": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@loader_path/../Frameworks",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.rhpt.mailchime.tests",
        "PRODUCT_NAME": "MailChimeTests",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/MailChime.app/Contents/MacOS/MailChime",
      },
    }, {
      "name": "MailChimeNotificationService",
      "id": "000000000000000000000051",
      "product": "Products/MailChimeNotificationService.appex",
      "product-type": "app-extension",
      "dependencies": [
        "MailChimeKit",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Support/MailChimeNotificationService.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1794237349",
        "DEVELOPMENT_TEAM": "F8AV3SGQFB",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Support/MailChimeNotificationService-Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MARKETING_VERSION": "2.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.rhpt.mailchime.NotificationService",
        "PRODUCT_NAME": "MailChimeNotificationService",
        "SKIP_INSTALL": "YES",
      },
    },
  ],
  "build-settings": {
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ENABLE_MODULES": "YES",
